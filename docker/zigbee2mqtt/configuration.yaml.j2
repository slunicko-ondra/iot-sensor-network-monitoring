version: 5

onboarding: false

homeassistant:
    enabled: false

frontend:
    enabled: true
    port: 8080

mqtt:
    base_topic: zigbee2mqtt
    server: "mqtt://mosquitto:1883"
    # user: my_user
    # password: my_password

{% if zigbee2mqtt_autodetect | bool == false %}
# Serial settings, only required when Zigbee2MQTT fails to start with:
#   USB adapter discovery error (No valid USB adapter found).
serial:
    # Location of the adapter
    # /dev/ttyACM0 is the device mounted to the container in the docker-compose.yaml file
    port: /dev/ttyACM0
    # Adapter type, allowed values: `zstack`, `ember`, `deconz`, `zigate` or `zboss`
    adapter: {{ adapter_type }}
{% endif %}

# Periodically check whether devices are online/offline
# availability:
#     enabled: false

# Advanced settings
advanced:
    log_level: info
    channel: 11
    # Let Zigbee2MQTT generate a network key on first start
    network_key: GENERATE
    # Let Zigbee2MQTT generate a pan_id on first start
    pan_id: GENERATE
    # Let Zigbee2MQTT generate an ext_pan_id on first start
    ext_pan_id: GENERATE

