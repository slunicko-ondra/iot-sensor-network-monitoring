<!DOCTYPE html>
<html lang="cz">
<head>
    <meta charset="UTF-8">
    <title>IoT Apps</title>
    <link rel="apple-touch-icon" sizes="180x180" href="assets/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="assets/favicon/site.webmanifest">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      :root{
        --bg: #0b1220;
        --surface: #0f1724;
        --muted: #9aa4b2;
        --card-alpha: 0.04;
        --radius: 12px;
        --fg: #e6eef8;
      }
      html,body{height:100%;}
      body{
        margin:0;
        font-family: Inter, Roboto, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial;
        background:linear-gradient(180deg,var(--bg),#07101a 120%);
        color:#e6eef8;
        -webkit-font-smoothing:antialiased;
        -moz-osx-font-smoothing:grayscale;
        display:flex;
        align-items:flex-start;
        justify-content:flex-start;
        padding:32px;
      }
      .container{width:100%;max-width:1100px}
      .section-title{
        margin:0 0 18px 0;
        font-size:24px;
        font-weight:600;
        color:#f7fbff;
      }
      .layout{
        display:grid;
        grid-template-columns:minmax(0,1fr) 320px;
        gap:24px;
        align-items:start;
      }
      .apps-section,.server-section{min-width:0;}
      .grid{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
        gap:16px;
      }
      .server-info{
        display:flex;
        flex-direction:column;
        gap:8px;
      }
      .server-info__row{
        display:flex;
        gap:8px;
        font-size:14px;
        line-height:1.4;
      }
      .server-info__label{color:var(--muted);min-width:82px;}
      .server-info__value{color:#f2f7ff;word-break:break-all;}
      .tile{
        position:relative;
        display:flex;
        flex-direction:column;
        align-items:flex-start;
        text-align:left;
        padding:18px 22px;
        background: rgba(255,255,255,var(--card-alpha));
        color:var(--fg,#fff);
        text-decoration:none;
        border-radius:var(--radius);
        transition:transform .14s ease, box-shadow .14s ease;
        box-shadow: 0 2px 8px rgba(2,6,23,0.6);
        overflow:hidden;
      }
      .tile:focus,
      .tile:hover{transform:translateY(-4px) scale(1.02); box-shadow: 0 8px 24px rgba(2,6,23,0.7);}
      .media{width:64px;height:64px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
      .logo{width:48px;height:48px;display:block;pointer-events: none;}
      .initials{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}
      .title{font-size:15px;font-weight:600}
      .title-row{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}
      .meta{font-size:12px;font-weight:500;color:var(--muted)}
      .subtitle{font-size:12px;color:var(--muted);margin-top:6px}

      /* accent bar on the left using CSS variable --accent */
      .tile::before{
        content:"";
        position:absolute;
        left:0;top:0;bottom:0;width:6px;border-radius:8px 0 0 8px;background:transparent;
      }
      .tile--grafana{--accent:#FF7A00}
      .tile--prometheus{--accent: #ea3d19}
      .tile--zigbee{--accent: #ffd60a}
      .tile--homeassistant{--accent: #1c9ff6}
      .tile--esphome{--accent: #27d4e6}
      .tile--netbird{--accent: #8b949e}
      .tile--grafana::before,.tile--prometheus::before,.tile--zigbee::before,.tile--homeassistant::before,.tile--esphome::before,.tile--netbird::before{background:var(--accent)}

      @media (max-width:900px){
        .layout{grid-template-columns:1fr;}
      }

      /* small responsive tweaks */
      @media (max-width:420px){
        .media{width:56px;height:56px}
        .title{font-size:14px}
      }
    </style>
</head>
<body>
  <div class="container">
    <div class="layout">
      <section class="apps-section" aria-label="Apps">
        <h1 class="section-title">Apps</h1>
        <nav class="grid" aria-label="IoT apps">
          <a class="tile tile--grafana" href="http://grafana.{{ ansible_hostname }}.{{ domain_name }}" aria-label="Grafana" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/grafana.svg" type="image/svg+xml" aria-label="Grafana logo"><div class="initials">G</div></object>
            </div>
            <div class="title">Grafana</div>
            <div class="subtitle">Dashboards & panels</div>
          </a>

          <a class="tile tile--prometheus" href="http://prometheus.{{ ansible_hostname }}.{{ domain_name }}" aria-label="Prometheus" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/prometheus.svg" type="image/svg+xml" aria-label="Prometheus logo"><div class="initials">P</div></object>
            </div>
            <div class="title">Prometheus</div>
            <div class="subtitle">Metrics & scraping</div>
          </a>

          <a class="tile tile--zigbee" href="http://zigbee2mqtt.{{ ansible_hostname }}.{{ domain_name }}" aria-label="Zigbee2MQTT" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/zigbee2mqtt.svg" type="image/svg+xml" aria-label="Zigbee2MQTT logo"><div class="initials">Z</div></object>
            </div>
            <div class="title">Zigbee2MQTT</div>
            <div class="subtitle">Zigbee device bridge</div>
          </a>

          <a class="tile tile--homeassistant" href="http://homeassistant.{{ ansible_hostname }}.{{ domain_name }}" aria-label="Home Assistant" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/home-assistant.svg" type="image/svg+xml" aria-label="Home Assistant logo"><div class="initials">H</div></object>
            </div>
            <div class="title">Home Assistant</div>
            <div class="subtitle">Automation & control</div>
          </a>

          <a class="tile tile--esphome" href="http://esphome.{{ ansible_hostname }}.{{ domain_name }}" aria-label="ESPHome" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/esphome.svg" type="image/svg+xml" aria-label="ESPHome logo"><div class="initials">E</div></object>
            </div>
            <div class="title">ESPHome</div>
            <div class="subtitle">Device configuration</div>
          </a>

          <a class="tile tile--netbird" href="https://app.netbird.io" aria-label="Netbird external link" target="_blank" rel="noopener noreferrer">
            <div class="media">
              <object class="logo" data="assets/netbird.svg" type="image/svg+xml" aria-label="Netbird logo"><div class="initials">N</div></object>
            </div>
            <div class="title-row">
              <div class="title">Netbird</div>
              <div class="meta">(external link)</div>
            </div>
            <div class="subtitle">Secure network access</div>
          </a>
        </nav>
      </section>

      <section class="server-section" aria-label="Server information">
        <h2 class="section-title">Server information</h2>
        <div class="server-info">
        <div class="server-info__row">
          <span class="server-info__label">Local IP:</span>
          <span class="server-info__value">{{ local_ip }}</span>
        </div>
        <div class="server-info__row">
          <span class="server-info__label">Netbird IP:</span>
          <span class="server-info__value">{{ netbird_ip }}</span>
        </div>
        </div>
      </section>
    </div>
  </div>
</body>
</html>