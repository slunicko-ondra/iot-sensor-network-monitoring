substitutions:
  device_name: {{ inventory_hostname }}
  sleep_duration: "5min"
  update_interval: "2s"
  log_level: "DEBUG"
  uart_speed: "115200"
  adc_pin: GPIO3
  button_pin: GPIO9

globals:
  - id: allow_sleep
    type: bool
    restore_value: false
    initial_value: "false"

esphome:
  name: ${device_name}
  on_boot:
    priority: 100
    then:
      - lambda: |-
          esp_sleep_source_t wakeup_reason = esp_sleep_get_wakeup_cause();
          if (wakeup_reason == ESP_SLEEP_WAKEUP_TIMER) {
            ESP_LOGI("main", "Woken up by timer. Normal operation.");
            id(allow_sleep) = true;
          } else {
            ESP_LOGI("main", "Woken up by reset or power. Entering 5-minute pairing/OTA mode.");
            id(allow_sleep) = false;
          }
      - if:
          condition:
            lambda: 'return id(allow_sleep);'
          then:
            - delay: 10s
            - deep_sleep.enter: deep_sleep_1
          else:
            - delay: 5min
            - deep_sleep.enter: deep_sleep_1

{% if esp_platform == 'esp8266' %}
# ERROR: Platform '{{ esp_platform }}' is not supported with Zigbee!
{% elif esp_platform == 'esp32' %}
esp32:
  variant: {{ esp_variant | default('esp32c6') }}
  partitions: partitions_zb.csv
  framework:
    type: esp-idf
{% else %}
# ERROR: Platform '{{ esp_platform }}' is not supported!
{% endif %}

logger:
  level: ${log_level}
  baud_rate: ${uart_speed}

external_components:
  - source: github://luar123/zigbee_esphome
    components: [zigbee]

zigbee:
  id: zigbee_solar
  components: all
  on_join:
    then:
      - logger.log: "Zigbee connected"

deep_sleep:
  id: deep_sleep_1
  sleep_duration: ${sleep_duration}

sensor:
  - platform: adc
    pin: ${adc_pin}
    id: solar_volt
    name: "Solar Voltage"
    unit_of_measurement: "V"
    device_class: "voltage"
    state_class: "measurement"
    accuracy_decimals: 2
    update_interval: ${update_interval}
    attenuation: 12dB
    filters:
      - multiply: 5.0
      - lambda: "return x < 0.25 ? 0.0 : x;"
    on_value:
      then:
        - zigbee.report: zigbee_solar
        - if:
            condition:
              lambda: 'return id(allow_sleep);'
            then:
              - delay: 500ms
              - logger.log: "Data sent. Entering deep sleep..."
              - deep_sleep.enter: deep_sleep_1

button:
  - platform: factory_reset
    id: reset_nvs_data
    name: "Delete NVS to enable Zigbee pairing"

binary_sensor:
  - platform: gpio
    pin:
      number: ${button_pin}
      mode: INPUT_PULLUP
      inverted: true
    id: boot_button
    name: "Boot Button"
    on_click:
      min_length: 5s
      max_length: 20s
      then:
        - logger.log: "Resetting Zigbee data and NVS..."
        - zigbee.reset: zigbee_solar
        - button.press: reset_nvs_data